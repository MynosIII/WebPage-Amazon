{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build_deploy.cjs",
  "outputDirectory": "portfolio-dist",
  "routes": [
    { "src": "/(.*)", "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "SAMEORIGIN", "Referrer-Policy": "strict-origin-when-cross-origin" }, "continue": true },
    { "src": "^/$", "dest": "/prototype-amazon/index.html" },
    { "src": "^/index-es\\.html$", "headers": { "Location": "/" }, "status": 308 },
    { "src": "^/index-en\\.html$", "headers": { "Location": "/index.html?lang=en" }, "status": 308 },
    { "src": "^/index\\.html$", "dest": "/prototype-amazon/index.html" },
    { "src": "^/about\\.html$", "dest": "/prototype-amazon/about.html" },
    { "src": "^/(?:prototype-amazon/)?case-amazon-growth\\.html$", "has": [{ "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/caso-1-en.html" }, "status": 308 },
    { "src": "^/(?:prototype-amazon/)?case-amazon-growth\\.html$", "headers": { "Location": "/caso-1-es.html" }, "status": 308 },
    { "src": "^/catalog\\.html$", "dest": "/prototype-amazon/catalog.html" },
    { "src": "^/contact\\.html$", "dest": "/prototype-amazon/contact.html" },
    { "src": "^/(?:prototype-amazon/)?page\\.html$", "has": [{ "type": "query", "key": "source", "value": "^(?:\\.\\./|\\./|/)?(?<article>(?:BI\\-case\\-2|Cases/DayParting\\-Case|Cases/amazon\\-listing\\-audit\\-checklist|Cases/automotive\\-fitment\\-seo|Cases/market\\-share\\-loss\\-diagnosis|Cases/search\\-query\\-keyword\\-harvesting|Cases/search\\-suppression\\-catalog\\-recovery|Cases/voice\\-of\\-customer\\-conversion\\-brief|Revolution_creative_case|SEO|amazon\\-content\\-architecture|amazon\\-lifecycle\\-operating\\-system|animation\\-01|animation\\-02|animation\\-03|animation\\-04|articulo\\-milei\\-chad|caso\\-1|caso\\-2|caso\\-3|caso\\-daizzy\\-gear|caso\\-hogar\\-cocina\\-ppc|construccion\\-portfolio|consultora|deteccion\\-copas\\-arboles|ecommerce\\-video\\-01|ecommerce\\-video\\-02|ecommerce\\-video\\-03|ecommerce\\-video\\-04|ecommerce\\-video\\-05|ecommerce\\-video\\-case|f1\\-predictor\\-walk\\-forward|icon\\-system\\-case|oxi\\-contenido\\-y\\-analisis|predestinato\\-simulador\\-carrera|revolution\\-operacion\\-amazon|shulex\\-voc\\-creative\\-case|telemetry\\-one\\-ecosistema|unimac\\-case))-(?:es|en)\\.html$" }, { "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/$article-en.html" }, "status": 308 },
    { "src": "^/(?:prototype-amazon/)?page\\.html$", "has": [{ "type": "query", "key": "source", "value": "^(?:\\.\\./|\\./|/)?(?<article>(?:BI\\-case\\-2|Cases/DayParting\\-Case|Cases/amazon\\-listing\\-audit\\-checklist|Cases/automotive\\-fitment\\-seo|Cases/market\\-share\\-loss\\-diagnosis|Cases/search\\-query\\-keyword\\-harvesting|Cases/search\\-suppression\\-catalog\\-recovery|Cases/voice\\-of\\-customer\\-conversion\\-brief|Revolution_creative_case|SEO|amazon\\-content\\-architecture|amazon\\-lifecycle\\-operating\\-system|animation\\-01|animation\\-02|animation\\-03|animation\\-04|articulo\\-milei\\-chad|caso\\-1|caso\\-2|caso\\-3|caso\\-daizzy\\-gear|caso\\-hogar\\-cocina\\-ppc|construccion\\-portfolio|consultora|deteccion\\-copas\\-arboles|ecommerce\\-video\\-01|ecommerce\\-video\\-02|ecommerce\\-video\\-03|ecommerce\\-video\\-04|ecommerce\\-video\\-05|ecommerce\\-video\\-case|f1\\-predictor\\-walk\\-forward|icon\\-system\\-case|oxi\\-contenido\\-y\\-analisis|predestinato\\-simulador\\-carrera|revolution\\-operacion\\-amazon|shulex\\-voc\\-creative\\-case|telemetry\\-one\\-ecosistema|unimac\\-case))-(?<locale>es|en)\\.html$" }], "headers": { "Location": "/$article-$locale.html" }, "status": 308 },
    { "src": "^/page\\.html$", "dest": "/prototype-amazon/page.html" },
    { "src": "^/styles\\.css$", "dest": "/prototype-amazon/styles.css" },
    { "src": "^/i18n\\.js$", "dest": "/prototype-amazon/i18n.js" },
    { "src": "^/script\\.js$", "dest": "/prototype-amazon/script.js" },
    { "src": "^/catalog\\.js$", "dest": "/prototype-amazon/catalog.js" },
    { "src": "^/viewer\\.js$", "dest": "/prototype-amazon/viewer.js" },
    { "src": "^/logo-signal\\.svg$", "dest": "/prototype-amazon/logo-signal.svg" },
    { "src": "^/robots\\.txt$", "dest": "/prototype-amazon/robots.txt" },
    { "src": "^/sitemap\\.xml$", "dest": "/prototype-amazon/sitemap.xml" },
    { "src": "^/prototype-amazon/?$", "headers": { "Location": "/" }, "status": 308 },
    { "handle": "filesystem" }
  ]
}
