{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build_deploy.cjs",
  "outputDirectory": "portfolio-dist",
  "routes": [
    { "src": "/(.*)", "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "SAMEORIGIN", "Referrer-Policy": "strict-origin-when-cross-origin" }, "continue": true },
    { "src": "^/(?:index\\.html)?$", "has": [{ "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/index-en.html" }, "status": 308 },
    { "src": "^/about\\.html$", "has": [{ "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/about-en.html" }, "status": 308 },
    { "src": "^/contact\\.html$", "has": [{ "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/contact-en.html" }, "status": 308 },
    { "src": "^/catalog\\.html$", "has": [{ "type": "query", "key": "lang", "value": "^en$" }, { "type": "query", "key": "section", "value": "^(?<section>[a-z]+)$" }], "headers": { "Location": "/catalog-en.html?section=$section" }, "status": 308 },
    { "src": "^/catalog\\.html$", "has": [{ "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/catalog-en.html" }, "status": 308 },
    { "src": "^/(index|about|catalog|contact)-en\\.html$", "dest": "/prototype-amazon/$1-en.html" },
    { "src": "^/$", "dest": "/prototype-amazon/index.html" },
    { "src": "^/index-es\\.html$", "headers": { "Location": "/" }, "status": 308 },
    { "src": "^/index\\.html$", "dest": "/prototype-amazon/index.html" },
    { "src": "^/about\\.html$", "dest": "/prototype-amazon/about.html" },
    { "src": "^/(?:prototype-amazon/)?case-amazon-growth\\.html$", "has": [{ "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/caso-1-en.html" }, "status": 308 },
    { "src": "^/(?:prototype-amazon/)?case-amazon-growth\\.html$", "headers": { "Location": "/caso-1-es.html" }, "status": 308 },
    { "src": "^/catalog\\.html$", "dest": "/prototype-amazon/catalog.html" },
    { "src": "^/contact\\.html$", "dest": "/prototype-amazon/contact.html" },
    { "src": "^/(?:prototype-amazon/)?page\\.html$", "has": [{ "type": "query", "key": "source", "value": "^(?:\\.\\./|\\./|/)?(?<article>(?:BI\\-case\\-2|Cases/DayParting\\-Case|Cases/amazon\\-listing\\-audit\\-checklist|Cases/automotive\\-fitment\\-seo|Cases/market\\-share\\-loss\\-diagnosis|Cases/search\\-query\\-keyword\\-harvesting|Cases/search\\-suppression\\-catalog\\-recovery|Cases/voice\\-of\\-customer\\-conversion\\-brief|Revolution_creative_case|SEO|amazon\\-content\\-architecture|amazon\\-lifecycle\\-operating\\-system|animation\\-01|animation\\-02|animation\\-03|animation\\-04|articulo\\-milei\\-chad|caso\\-1|caso\\-2|caso\\-3|caso\\-daizzy\\-gear|caso\\-hogar\\-cocina\\-ppc|construccion\\-portfolio|consultora|deteccion\\-copas\\-arboles|ecommerce\\-video\\-01|ecommerce\\-video\\-02|ecommerce\\-video\\-03|ecommerce\\-video\\-04|ecommerce\\-video\\-05|ecommerce\\-video\\-case|f1\\-predictor\\-walk\\-forward|icon\\-system\\-case|limpieza\\-audio\\-entrevista\\-ia|oxi\\-contenido\\-y\\-analisis|postproduccion\\-video\\-davinci\\-resolve\\-ia|predestinato\\-simulador\\-carrera|revolution\\-operacion\\-amazon|shulex\\-voc\\-creative\\-case|telemetry\\-one\\-ecosistema|trabajo\\-con\\-claude|unimac\\-case))-(?:es|en)\\.html$" }, { "type": "query", "key": "lang", "value": "^en$" }], "headers": { "Location": "/$article-en.html" }, "status": 308 },
    { "src": "^/(?:prototype-amazon/)?page\\.html$", "has": [{ "type": "query", "key": "source", "value": "^(?:\\.\\./|\\./|/)?(?<article>(?:BI\\-case\\-2|Cases/DayParting\\-Case|Cases/amazon\\-listing\\-audit\\-checklist|Cases/automotive\\-fitment\\-seo|Cases/market\\-share\\-loss\\-diagnosis|Cases/search\\-query\\-keyword\\-harvesting|Cases/search\\-suppression\\-catalog\\-recovery|Cases/voice\\-of\\-customer\\-conversion\\-brief|Revolution_creative_case|SEO|amazon\\-content\\-architecture|amazon\\-lifecycle\\-operating\\-system|animation\\-01|animation\\-02|animation\\-03|animation\\-04|articulo\\-milei\\-chad|caso\\-1|caso\\-2|caso\\-3|caso\\-daizzy\\-gear|caso\\-hogar\\-cocina\\-ppc|construccion\\-portfolio|consultora|deteccion\\-copas\\-arboles|ecommerce\\-video\\-01|ecommerce\\-video\\-02|ecommerce\\-video\\-03|ecommerce\\-video\\-04|ecommerce\\-video\\-05|ecommerce\\-video\\-case|f1\\-predictor\\-walk\\-forward|icon\\-system\\-case|limpieza\\-audio\\-entrevista\\-ia|oxi\\-contenido\\-y\\-analisis|postproduccion\\-video\\-davinci\\-resolve\\-ia|predestinato\\-simulador\\-carrera|revolution\\-operacion\\-amazon|shulex\\-voc\\-creative\\-case|telemetry\\-one\\-ecosistema|trabajo\\-con\\-claude|unimac\\-case))-(?<locale>es|en)\\.html$" }], "headers": { "Location": "/$article-$locale.html" }, "status": 308 },
    {"src": "^/ecommerce-en\\.html$", "headers": {"Location": "/catalog.html?section=ecommerce&lang=en"}, "status": 308},
    {"src": "^/ecommerce(?:-es)?\\.html$", "headers": {"Location": "/catalog.html?section=ecommerce"}, "status": 308},
    {"src": "^/Articles-en\\.html$", "headers": {"Location": "/catalog.html?section=articles&lang=en"}, "status": 308},
    {"src": "^/Articles(?:-es)?\\.html$", "headers": {"Location": "/catalog.html?section=articles"}, "status": 308},
    {"src": "^/creatives-en\\.html$", "headers": {"Location": "/catalog.html?section=creative&lang=en"}, "status": 308},
    {"src": "^/creatives(?:-es)?\\.html$", "headers": {"Location": "/catalog.html?section=creative"}, "status": 308},
    {"src": "^/otros-en\\.html$", "headers": {"Location": "/catalog.html?section=other&lang=en"}, "status": 308},
    {"src": "^/otros(?:-es)?\\.html$", "headers": {"Location": "/catalog.html?section=other"}, "status": 308},
    {"src": "^/sobre-mi-en\\.html$", "headers": {"Location": "/about.html?lang=en"}, "status": 308},
    {"src": "^/sobre-mi(?:-es)?\\.html$", "headers": {"Location": "/about.html"}, "status": 308},
    {"src": "^/(?:prototype-amazon/)?page\\.html$", "has": [{"type": "query", "key": "source", "value": "^(?:\\.\\./|\\./|/)?cv-(?<locale>es|en)\\.html$"}], "headers": {"Location": "/cv-$locale.html"}, "status": 308},
    {"src": "^/(BI\\-case\\-2|Cases\\/DayParting\\-Case|Cases\\/amazon\\-listing\\-audit\\-checklist|Cases\\/automotive\\-fitment\\-seo|Cases\\/market\\-share\\-loss\\-diagnosis|Cases\\/search\\-query\\-keyword\\-harvesting|Cases\\/search\\-suppression\\-catalog\\-recovery|Cases\\/voice\\-of\\-customer\\-conversion\\-brief|Revolution_creative_case|SEO|amazon\\-content\\-architecture|amazon\\-lifecycle\\-operating\\-system|animation\\-01|animation\\-02|animation\\-03|animation\\-04|articulo\\-milei\\-chad|caso\\-1|caso\\-2|caso\\-3|caso\\-daizzy\\-gear|caso\\-hogar\\-cocina\\-ppc|consultora|cv|documento|ecommerce\\-video\\-01|ecommerce\\-video\\-02|ecommerce\\-video\\-03|ecommerce\\-video\\-04|ecommerce\\-video\\-05|ecommerce\\-video\\-case|icon\\-system\\-case|shulex\\-voc\\-creative\\-case|unimac\\-case)\\.html$", "headers": {"Location": "/$1-es.html"}, "status": 308},
    { "src": "^/page\\.html$", "dest": "/prototype-amazon/page.html" },
    { "src": "^/styles\\.css$", "dest": "/prototype-amazon/styles.css" },
    { "src": "^/i18n\\.js$", "dest": "/prototype-amazon/i18n.js" },
    { "src": "^/script\\.js$", "dest": "/prototype-amazon/script.js" },
    { "src": "^/catalog\\.js$", "dest": "/prototype-amazon/catalog.js" },
    { "src": "^/viewer\\.js$", "dest": "/prototype-amazon/viewer.js" },
    { "src": "^/logo-signal\\.svg$", "dest": "/prototype-amazon/logo-signal.svg" },
    { "src": "^/robots\\.txt$", "dest": "/prototype-amazon/robots.txt" },
    { "src": "^/sitemap\\.xml$", "dest": "/prototype-amazon/sitemap.xml" },
    { "src": "^/prototype-amazon/?$", "headers": { "Location": "/" }, "status": 308 },
    { "handle": "filesystem" }
  ]
}
